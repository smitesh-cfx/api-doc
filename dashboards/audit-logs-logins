            {
              "column": "user_id",
              "agg": "cardinality",
              "type": "int",
              "display_type": "vertical-line"
            }
          ],
          "widget_id": "1704af80"
        },
        {
          "widget_type": "bar_chart",
          "title": "Top 20 Users",
          "stream": "rda_system_audit_logs",
          "top_n": 20,
          "ts_column": "timestamp",
          "column": "count_",
