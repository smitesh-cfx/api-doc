      "name": "pstream_data_browser.html",
      "value": "<script>\nwindow.pstream_name = {{ pstream_name | default(PSTREAM_NAME | default('')) | string | tojson }};\n(function () {\n  function luminance(r, g, b) {\n    var s = [r, g, b].map(function (v) {\n      v /= 255;\n      return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);\n    });\n    return 0.2126 * s[0] + 0.7152 * s[1] + 0.0722 * s[2];\n  }\n  var lastTheme = null;\n  function syncThemeFromParent() {\n    try {\n      if (!window.parent || window.parent === window) return;\n      var parentRoot = window.parent.document.documentElement;\n      var parentStyles = window.parent.getComputedStyle(parentRoot);\n      var iframeRoot = document.documentElement;\n      Array.from(parentStyles).forEach(function (p) {\n        if (p.indexOf(\"--\") === 0) iframeRoot.style.setProperty(p, parentStyles.getPropertyValue(p));\n      });\n      var raw = parentStyles.getPropertyValue(\"--v-theme-cfxbackground\").trim();\n      var parts = raw.split(\",\").map(Number);\n      var theme = null;\n      if (parts.length === 3 && !parts.some(isNaN)) {\n        theme = luminance(parts[0], parts[1], parts[2]) < 0.35 ? \"dark\" : \"light\";\n      }\n      if (!theme) {\n        var cls = parentRoot.className || \"\";\n        if (cls.indexOf(\"v-theme--dark\") !== -1) theme = \"dark\";\n        else if (cls.indexOf(\"v-theme--light\") !== -1) theme = \"light\";\n        else theme = parentRoot.getAttribute(\"data-theme\");\n      }\n      if (theme) {\n        iframeRoot.setAttribute(\"data-theme\", theme);\n        if (theme !== lastTheme) {\n          lastTheme = theme;\n          try { window.dispatchEvent(new CustomEvent(\"themechange\")); } catch (e2) {}\n        }\n      }\n    } catch (e) { /* cross-origin parent: ignore, fall back to authored theme */ }\n  }\n  syncThemeFromParent();\n  try {\n    new MutationObserver(syncThemeFromParent).observe(\n      window.parent.document.documentElement,\n      { attributes: true, attributeFilter: [\"class\", \"data-theme\", \"style\"] }\n    );\n    setInterval(syncThemeFromParent, 800);\n  } catch (e) { /* cross-origin: ignore */ }\n})();\n</script>\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Pstream Data Browser</title>\n<style>\n  :root {\n    --bg: #FCFCFC;\n    --text: #212121;\n    --text-sec: #616161;\n    --text-muted: #737373;\n    --primary: #1976D2;\n    --primary-soft: rgba(25,118,210,0.10);\n    --border: rgba(0,0,0,0.12);\n    --card-bg: #ffffff;\n    --header-bg: #f5f5f5;\n    --success: #4CAF50;\n    --error: #D32F2F;\n    --radius-sm: 4px;\n    --radius-md: 8px;\n  }\n  html[data-theme=\"dark\"] {\n    --bg: #0a0a0a;\n    --text: #e8ecf5;\n    --text-sec: #c8c8c8;\n    --text-muted: #BDBDBD;\n    --primary: #90CAF9;\n    --primary-soft: rgba(144,202,249,0.14);\n    --border: rgba(255,255,255,0.15);\n    --card-bg: #171717;\n    --header-bg: #262626;\n  }\n  *, *::before, *::after { box-sizing: border-box; }\n  html, body {\n    margin: 0; padding: 0;\n    width: 100%; height: 100%;\n    font-family: \"Avenir\", \"Roboto\", \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n    font-size: 14px;\n    color: var(--text);\n    background: var(--bg);\n    overflow-x: hidden;\n    overflow-y: auto;\n  }\n  #root { height: 100%; }\n  /* Full-height app shell: the page never scrolls; the grid and the left\n     column panel scroll internally. */\n  .wpd-container {\n    height: 100vh; padding: 16px;\n    display: flex; flex-direction: column; gap: 16px;\n    overflow: hidden;\n  }\n  .wpd-container > * { flex: 0 0 auto; }\n  .wpd-title { font-size: 16px; font-weight: 400; margin: 0; color: var(--text); }\n  .wpd-subtitle { font-size: 12px; color: var(--text-muted); margin: 2px 0 0 0; }\n  .wpd-section { display: flex; flex-direction: column;}\n  .wpd-section-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }\n  .wpd-section-title { font-size: 12px; font-weight: 600; color: var(--text-sec); text-transform: uppercase; letter-spacing: 0.04em; }\n  .wpd-card {\n    background: var(--card-bg);\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n    padding: 12px 14px;\n  }\n  .wpd-empty, .wpd-loading, .wpd-error {\n    color: var(--text-muted);\n    text-align: center;\n    padding: 32px 16px;\n    font-size: 13px;\n  }\n  .wpd-error { color: var(--error); }\n\n  /* --- header / picker --- */\n  .wpd-header-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }\n  .wpd-picker { position: relative; width: 340px; max-width: 100%; }\n  .wpd-picker input {\n    width: 100%;\n    padding: 7px 10px;\n    font-size: 13px;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-sm);\n    background: var(--card-bg);\n    color: var(--text);\n    outline: none;\n    font-family: inherit;\n  }\n  .wpd-picker input:focus { border-color: var(--primary); }\n  .wpd-picker-list {\n    position: absolute; z-index: 20; top: calc(100% + 4px); left: 0; right: 0;\n    max-height: 300px; overflow-y: auto;\n    background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-md);\n    box-shadow: 0 3px 4px rgba(0,0,0,0.10);\n  }\n  .wpd-picker-item { padding: 7px 10px; cursor: pointer; font-size: 13px; }\n  .wpd-picker-item:hover, .wpd-picker-item.active { background: var(--primary-soft); }\n  .wpd-picker-item-name { color: var(--text); }\n  .wpd-picker-item-desc { color: var(--text-muted); font-size: 11px; margin-top: 1px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n  .wpd-stream-desc { font-size: 12px; color: var(--text-sec); }\n\n  /* --- header controls (pstream picker + time range) --- */\n  .wpd-header-controls { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }\n  .wpd-time-select {\n    -webkit-appearance: none;\n    appearance: none;\n    padding: 7px 10px; font-size: 13px;\n    border: 1px solid var(--border); border-radius: var(--radius-sm);\n    background: var(--card-bg); color: var(--text);\n    outline: none; cursor: pointer; font-family: inherit;\n  }\n  .wpd-time-select:focus { border-color: var(--primary); }\n  /* Match the \"Saved Filters\" / \"Custom range\" buttons to the picker input\n     and time select's size \u2014 .wpd-tool-btn elsewhere (toolbar) stays compact. */\n  .wpd-header-controls .wpd-tool-btn { padding: 7px 10px; font-size: 13px; }\n\n  /* --- compact stat strip, inline with the page title --- */\n  .wpd-stat-strip { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; font-size: 11.5px; color: var(--text-muted); }\n  .wpd-stat-sep { color: var(--border); }\n  .wpd-stat-label { color: var(--text-muted); }\n  .wpd-stat-value { color: var(--text); font-weight: 600; }\n\n  /* --- chart --- */\n  .wpd-chart-wrap { position: relative; }\n  #wpd-chart-canvas { width: 100%; height: 90px; display: block; }\n  .wpd-chart-tip {\n    position: fixed; pointer-events: none; display: none; z-index: 999;\n    background: var(--header-bg); color: var(--text); border: 1px solid var(--border);\n    border-radius: var(--radius-sm); padding: 4px 8px; font-size: 11px; white-space: nowrap;\n  }\n\n  /* --- main split: left column panel + data table (fills leftover height) --- */\n  .wpd-main { display: flex; gap: 14px; flex: 1 1 auto; min-height: 260px; overflow: hidden; }\n  .wpd-side {\n    width: 300px; flex-shrink: 0; min-height: 0;\n    display: flex; flex-direction: column; gap: 8px;\n  }\n  .wpd-side-list {\n    display: flex; flex-direction: column; gap: 8px;\n    flex: 1 1 auto; min-height: 0; overflow-y: auto;\n    padding-right: 2px;\n  }\n  .wpd-content { flex: 1; min-width: 0; min-height: 0; display: flex; flex-direction: column; gap: 10px; }\n  .wpd-fill { flex: 1 1 auto; min-height: 0; }\n  @media (max-width: 900px) {\n    .wpd-container { height: auto; overflow: visible; }\n    .wpd-main { flex-direction: column; overflow: visible; }\n    .wpd-side { width: 100%; }\n    .wpd-side-list { max-height: 320px; }\n    #wpd-grid { min-height: 380px;}\n  }\n\n  /* --- column cards (left panel) --- */\n  .wpd-col-card { display: flex; flex-direction: column; gap: 6px; padding: 10px 12px; }\n  .wpd-col-head { display: flex; align-items: center; justify-content: space-between; gap: 6px; }\n  .wpd-col-name { font-weight: 600; font-size: 12.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n  .wpd-col-type {\n    font-size: 10px; text-transform: uppercase; letter-spacing: 0.03em;\n    color: var(--text-muted); border: 1px solid var(--border); border-radius: var(--radius-sm);\n    padding: 1px 5px; flex-shrink: 0;\n  }\n  .wpd-coverage-bar { height: 6px; border-radius: 4px; background: var(--border); overflow: hidden; display: flex; }\n  .wpd-coverage-fill { background: var(--success); height: 100%; }\n  .wpd-coverage-label { font-size: 11px; color: var(--text-muted); display: flex; justify-content: space-between; gap: 6px; flex-wrap: wrap; }\n  .wpd-coverage-label .n { color: var(--text); }\n  .wpd-col-unique { font-size: 11px; color: var(--text-muted); }\n  .wpd-col-unique .n { color: var(--text); }\n\n  .wpd-facet-toggle {\n    font-size: 11px; color: var(--primary); cursor: pointer; background: none; border: none; padding: 0;\n    text-align: left; font-family: inherit;\n  }\n  .wpd-facet-toggle:hover { text-decoration: underline; }\n  .wpd-facet-box { margin-top: 4px; border-top: 1px dashed var(--border); padding-top: 6px; }\n  .wpd-facet-search {\n    width: 100%; font-size: 12px; padding: 4px 6px; margin-bottom: 6px;\n    border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg); color: var(--text);\n    font-family: inherit;\n  }\n  .wpd-facet-list { max-height: 170px; overflow-y: auto; display: flex; flex-direction: column; gap: 3px; }\n  .wpd-facet-row { display: flex; align-items: center; gap: 6px; font-size: 12px; cursor: pointer; }\n  .wpd-facet-row label { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer; }\n  .wpd-facet-count { color: var(--text-muted); font-size: 11px; }\n  .wpd-facet-empty { font-size: 11px; color: var(--text-muted); padding: 4px 0; }\n  .wpd-facet-note { font-size: 10.5px; color: var(--text-muted); font-style: italic; }\n\n  /* --- active filter chips --- */\n  .wpd-chips { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }\n  .wpd-chip {\n    display: inline-flex; align-items: center; gap: 5px;\n    background: var(--primary-soft); color: var(--text);\n    border: 1px solid var(--border); border-radius: 999px;\n    padding: 3px 6px 3px 10px; font-size: 11.5px;\n  }\n  .wpd-chip button {\n    border: none; background: none; cursor: pointer; color: var(--text-muted);\n    font-size: 13px; line-height: 1; padding: 0 2px;\n  }\n  .wpd-chip button:hover { color: var(--error); }\n  .wpd-clear-all { font-size: 11.5px; color: var(--primary); background: none; border: none; cursor: pointer; padding: 0; font-family: inherit; }\n  .wpd-clear-all:hover { text-decoration: underline; }\n\n  /* --- shared toolbar (columns / page size / pagination), sits above both\n     the left column panel and the table --- */\n  .wpd-table-toolbar {\n    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;\n    background: var(--header-bg); border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n    padding: 8px 10px;\n  }\n  .wpd-toolbar-info { font-size: 11.5px; color: var(--text-muted); }\n  .wpd-pager { display: flex; align-items: center; gap: 6px; }\n  .wpd-pager-info { font-size: 11.5px; color: var(--text-muted); min-width: 90px; text-align: center; }\n  .wpd-pagesize { display: flex; align-items: center; gap: 6px; font-size: 11.5px; color: var(--text-muted); margin-left: auto; }\n  .wpd-pagesize-input {\n    width: 70px; font-size: 12px; padding: 4px 6px;\n    border: 1px solid var(--border); border-radius: var(--radius-sm);\n    background: var(--card-bg); color: var(--text); font-family: inherit;\n  }\n  .wpd-pagesize-input:focus { border-color: var(--primary); }\n  .wpd-tool-btn:disabled { opacity: 0.45; cursor: default; }\n  .wpd-tool-btn:disabled:hover { border-color: var(--border); }\n  .wpd-tool-btn {\n    font-size: 12px; padding: 5px 10px; border-radius: var(--radius-sm);\n    border: 1px solid var(--border); background: var(--card-bg); color: var(--text);\n    cursor: pointer; font-family: inherit; position: relative;\n  }\n  .wpd-tool-btn:hover { border-color: var(--primary); }\n  .wpd-colpick { position: relative; }\n  .wpd-colpick-menu {\n    position: absolute; z-index: 30; top: calc(100% + 4px); right: 0;\n    width: 240px; max-height: 300px; overflow-y: auto;\n    background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-md);\n    box-shadow: 0 3px 4px rgba(0,0,0,0.10); padding: 8px;\n  }\n  .wpd-colpick-menu-left { right: auto; left: 0; }\n  .wpd-colpick-actions { display: flex; gap: 10px; padding-bottom: 6px; border-bottom: 1px solid var(--border); margin-bottom: 6px; }\n  .wpd-colpick-actions button { font-size: 11px; color: var(--primary); background: none; border: none; cursor: pointer; padding: 0; font-family: inherit; }\n  .wpd-colpick-actions button:hover { text-decoration: underline; }\n  .wpd-colpick-row { display: flex; align-items: center; gap: 6px; font-size: 12px; padding: 3px 2px; cursor: pointer; }\n  .wpd-colpick-row label { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer; }\n  .wpd-colpick-move { display: flex; gap: 1px; flex-shrink: 0; }\n  .wpd-colpick-move button {\n    border: none; background: none; cursor: pointer; color: var(--text-muted);\n    font-size: 12px; padding: 0 3px; line-height: 1;\n  }\n  .wpd-colpick-move button:hover { color: var(--primary); }\n\n  /* --- custom set-filter popup (inside AG Grid menu) --- */\n  .wpd-agset { padding: 8px; width: 230px; font-size: 12px; color: var(--text); font-family: inherit; }\n  .wpd-agset-quick { display: flex; gap: 10px; margin-bottom: 6px; flex-wrap: wrap; }\n  .wpd-agset-quick button {\n    background: none; border: none; color: var(--primary); cursor: pointer;\n    padding: 0; font-family: inherit; font-size: 11px;\n  }\n  .wpd-agset-quick button:hover { text-decoration: underline; }\n  .wpd-agset-quick button.on { font-weight: 700; text-decoration: underline; }\n  .wpd-agset-note { font-size: 10.5px; color: var(--text-muted); margin: 4px 0; }\n  .wpd-agset-op {\n    width: 100%; font-size: 12px; padding: 4px 6px; margin-bottom: 6px;\n    border: 1px solid var(--border); border-radius: var(--radius-sm);\n    background: var(--card-bg); color: var(--text); font-family: inherit; cursor: pointer;\n  }\n  .wpd-agset-apply {\n    margin-top: 6px; font-size: 12px; padding: 3px 10px;\n    border: 1px solid var(--border); border-radius: var(--radius-sm);\n    background: var(--card-bg); color: var(--text); cursor: pointer; font-family: inherit;\n  }\n  .wpd-agset-apply:hover { border-color: var(--primary); }\n\n  .wpd-savef-row { display: flex; gap: 6px; align-items: center; padding-bottom: 6px; border-bottom: 1px solid var(--border); margin-bottom: 6px; }\n  .wpd-savef-row input { margin-bottom: 0; flex: 1; }\n  .wpd-savef-row .wpd-agset-apply { margin-top: 0; }\n  .wpd-savef-del { border: none; background: none; cursor: pointer; color: var(--text-muted); font-size: 14px; padding: 0 2px; }\n  .wpd-savef-del:hover { color: var(--error); }\n\n  /* --- header right-click menu --- */\n  .wpd-hdrmenu {\n    position: fixed; z-index: 99999; min-width: 140px;\n    background: var(--card-bg); border: 1px solid var(--border);\n    border-radius: var(--radius-md); box-shadow: 0 3px 4px rgba(0,0,0,0.10);\n    padding: 4px; font-size: 12.5px; color: var(--text);\n  }\n  .wpd-hdrmenu-item { padding: 5px 10px; border-radius: var(--radius-sm); cursor: pointer; }\n  .wpd-hdrmenu-item:hover { background: var(--primary-soft); }\n\n  /* --- data grid (AG Grid): fills whatever height the split leaves --- */\n  #wpd-grid {\n    flex: 1 1 auto;\n    min-height: 200px;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n    overflow: hidden;\n    background: var(--card-bg);\n  }\n  .wpd-table-footer { font-size: 11.5px; color: var(--text-muted); padding: 8px 4px; text-align: center; }\n\n  /* Always-visible scrollbars in the grid (overlay scrollbars hide the\n     horizontal bar entirely when embedded in the portal shell). */\n  #wpd-grid ::-webkit-scrollbar { width: 10px; height: 10px; }\n  #wpd-grid ::-webkit-scrollbar-track { background: var(--header-bg); }\n  #wpd-grid ::-webkit-scrollbar-thumb {\n    background: color-mix(in srgb, var(--text) 25%, transparent);\n    border-radius: 5px;\n    border: 2px solid var(--header-bg);\n  }\n  #wpd-grid ::-webkit-scrollbar-thumb:hover {\n    background: color-mix(in srgb, var(--text) 40%, transparent);\n  }\n  #wpd-grid .ag-body-horizontal-scroll-viewport,\n  #wpd-grid .ag-body-vertical-scroll-viewport { scrollbar-width: thin; }\n\n  /* Cap the grid body to the viewport. In some host embeds the grid grows\n     taller than the visible area, pushing the bottom-anchored horizontal\n     scrollbar out of sight; this pulls it up to just below the visible rows.\n     Not binding in a correctly-sized layout (the body is already shorter).\n     Leaves more room back to the grid when the time series chart is hidden. */\n  #wpd-grid .ag-body { max-height: max(200px, calc(100vh - 400px)); }\n  .wpd-chart-collapsed #wpd-grid .ag-body { max-height: max(200px, calc(100vh - 250px)); }\n  .wpd-spinner {\n    display: inline-block; width: 12px; height: 12px; border-radius: 50%;\n    border: 2px solid var(--border); border-top-color: var(--primary);\n    animation: wpd-spin 0.7s linear infinite; vertical-align: middle; margin-right: 6