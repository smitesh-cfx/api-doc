{
  "name": "rda-dashboard-view-logs",
  "label": "Export Job Logs",
  "description": "Dashboard Schedule Logs: Insights",
  "dashboard_folder": "System",
  "version": "1.0.3",
  "enabled": false,
  "dashboard_type": "template",
  "status_poller": {
    "stream": "rda_dashboard_schedule_logs",
    "frequency": 30,
    "columns": [
      "timestamp"
    ]
  },
  "template_variables": {
    "JOBID": {
      "contextId": "job_id"
    }
  },
  "dashboard_filters": {
    "time_filter": true,
    "extra_filter": "job_id is '{{JOBID}}'",
    "default_time_filter_labels": [
      "Last 1 month"
    ],
    "columns_filter": [
      {
        "id": "timestamp",
        "label": "Timestamp",
        "type": "DATETIME"
      }
    ],
    "group_filters": []
  },
  "dashboard_sections": [
    {
      "title": "Schedule Logs",
      "show_filter": true,
      "widgets": [
        {
          "title": "Schedule Logs",
          "widget_type": "tabular",
          "stream": "rda_dashboard_schedule_logs",
          "height": 4,
          "paginated": true,
          "max_width": 12,
          "min_width": 12,
          "sorting": [
            {
              "timestamp": "desc"
            }
          ],
          "columns": {
            "ingestion_id": "Job ID",
            "timestamp": {
              "title": "Timestamp",
              "type": "DATETIME"
            },
            "status": "Progress",
            "job_id": {
              "title": "ID",
              "visible": false
            },
            "reason": "Reason"
          },
          "widget_id": "b2c8d81c"
        }
      ]
    }
  ],
  "pstream_dashboards": [
    {
      "title": "Schedule Logs",
      "show_filter": true,
      "widgets": [
        {
          "title": "Schedule Logs",
          "widget_type": "tabular",
          "stream": "rda_dashboard_schedule_logs",
          "height": 4,
          "paginated": true,
          "max_width": 12,
          "min_width": 12,
          "sorting": [
            {
              "timestamp": "desc"
            }
          ],
          "columns": {
            "ingestion_id": "Job ID",
            "timestamp": {
              "title": "Timestamp",
              "type": "DATETIME"
            },
            "status": "Progress",
            "job_id": {
              "title": "ID",
              "visible": false
            },
            "reason": "Reason"
          },
          "widget_id": "b2c8d81c"
        }
      ]
    }
  ]
}