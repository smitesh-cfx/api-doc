{
  "name": "rda-mgmt-page-system-dashboards",
  "label": "Dashboards",
  "description": "User Dashboard Management Page",
  "enabled": false,
  "dashboard_type": "dashboard",
  "dashboard_folder": "System",
  "stream": "rda_dashboards_meta",
  "dashboard_filters": {
    "time_filter": true,
    "extra_filter": "( dashboard_folder in 'System')",
    "group_filters": [
      {
        "stream": "rda_dashboards_meta",
        "title": "Folder",
        "limit": 200,
        "extra_filter": null,
        "duration_hours": 87600,
        "group_by": [
          "dashboard_folder"
        ],
        "ts_column": "saved_time",
        "agg": "value_count",
        "column": "count_",
        "type": "int"
      },
      {
        "stream": "rda_dashboards_meta",
        "title": "Type",
        "duration_hours": 87600,
        "limit": 200,
        "group_by": [
          "dashboard_type"
        ],
        "ts_column": "saved_time",
        "agg": "value_count",
        "column": "count_",
        "type": "int"
      }
    ],
    "columns_filter": [
      {
        "id": "saved_time",
        "label": "Saved Time",
        "type": "DATETIME"
      },
      {
        "id": "name",
        "label": "Name",
        "type": "TEXT"
      },
      {
        "id": "label",
        "label": "Label",
        "type": "TEXT"
      },
      {
        "id": "dashboard_folder",
        "label": "Folder",
        "type": "TEXT"
      },
      {
        "id": "dashboard_type",
        "label": "Dashboard Type",
        "type": "TEXT"
      },
      {
        "id": "_RDA_Id",
        "label": "_RDA_ID",
        "type": "TEXT"
      },
      {
        "id": "count_",
        "label": "Count_",
        "type": "DOUBLE"
      },
      {
        "id": "enabled",
        "label": "Enabled",
        "type": "BOOLEAN"
      },
      {
        "id": "description",
        "label": "Description",
        "type": "TEXT"
      },
      {
        "id": "reltime",
        "label": "RelTime",
        "type": "DATETIME"
      },
      {
        "id": "timestamp",
        "label": "Timestamp",
        "type": "DATETIME"
      }
    ]
  },
  "dashboard_sections": [
    {
      "title": "Dashboards",
      "show_filter": true,
      "widgets": [
        {
          "widget_type": "pie_chart",
          "title": "Dashboards By Folders",
          "stream": "rda_dashboards_meta",
          "duration_hours": 87600,
          "limit": 25,
          "ts_column": "saved_time",
          "min_width": 6,
          "height": 4,
          "max_width": 6,
          "column": "count_",
          "agg": "value_count",
          "group_by": [
            "dashboard_folder"
          ],
          "type": "int",
          "widget_id": "cb0706e6"
        },
        {
          "widget_type": "pie_chart",
          "title": "Dashboards By Type",
          "stream": "rda_dashboards_meta",
          "duration_hours": 87600,
          "limit": 25,
          "ts_column": "saved_time",
          "min_width": 6,
          "height": 4,
          "max_width": 6,
          "column": "count_",
          "agg": "value_count",
          "group_by": [
            "dashboard_type"
          ],
          "type": "int",
          "widget_id": "51074892"
        },
        {
          "title": "Dashboards",
          "widget_type": "tabular",
          "duration_hours": 87600,
          "stream": "rda_dashboards_meta",
          "remote_searchable": true,
          "remote_searchable_cols": [
            "name",
            "dashboard_folder",
            "dashboard_type",
            "label",
            "description"
          ],
          "ts_column": "saved_time",
          "paginated": true,
          "height": 10,
          "min_wdith": 12,
          "columns": {
            "name": {
              "title": "Name",
              "key": true
            },
            "dashboard_folder": {
              "title": "Dashboard Folder"
            },
            "type": {
              "title": "Type",
              "type": "FIXED_VALUE",
              "value": "Dashboard",
              "visible": false,
              "sortable": false
            },
            "dashboard_type": {
              "title": "Dashboard Type"
            },
            "label": {
              "title": "Label"
            },
            "description": {
              "title": "Description"
            },
            "saved_time": {
              "title": "Saved Time",
              "type": "DATETIME"
            },
            "timestamp": {
              "title": "When",
              "type": "HUMANIZE_TIME_DELTA",
              "source-column": "saved_time",
              "sortable": false
            }
          },
          "custom_columns": [
            {
              "id": "enabled",
              "label": "Enabled",
              "htmlTemplateForRow": "<span class='badge' style='background-color: {{ row.enableColor }}' > {{ row.enabled }} </span>"
            },
            {
              "id": "id",
              "label": "ID",
              "expr": "'user-dashboard-' + name",
              "visible": false,
              "key": true,
              "sortable": false
            },
            {
              "id": "url",
              "label": "URL",
              "expr": "'/workspace/dashboard/user-dashboard-' + name",
              "visible": false,
              "sortable": false
            },
            {
              "id": "enableColor",
              "label": "Enable Color",
              "expr": "['#4CAF50'] if enabled else ['#9E9E9E']",
              "hidden": true,
              "visible": false,
              "sortable": false
            },
            {
              "id": "rowStyleClass",
              "hidden": true,
              "visible": false,
              "expr": "'bg-fading-blue' if time_now_as_ms() - isoformat_to_ms(saved_time) <= 120000 else None",
              "sortable": false
            },
            {
              "id": "artifact_name",
              "label": "Artifact Name",
              "expr": "name",
              "key": true,
              "visible": false,
              "sortable": false
            },
            {
              "id": "artifact_type",
              "label": "Artifact Type",
              "expr": "'dashboard'",
              "key": true,
              "visible": false,
              "sortable": false
            }
          ],
          "actions": [
