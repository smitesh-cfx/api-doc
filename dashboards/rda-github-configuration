          "height": 6,
          "min_wdith": 12,
          "columns": {
            "timestamp": {
              "title": "Last Updated",
              "type": "DATETIME"
            }
          },
          "actions": [
            {
              "permission": "rda:github:push",
              "title": "Configure Git",
              "type": "POPUP_FORM",
              "selectionType": "NONE",
              "identifier": "saas-service-action:github-settings",
              "api-endpoint": {
                "service-name": "saas-reports",
                "methodName": "getForm",
                "stringified-params": true,
                "parse-output": false,
                "params": [
                  {
                    "formId": "rda.saas.git.settings"
                  }
