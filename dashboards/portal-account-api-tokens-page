            "expiresAt": {
              "title": "Expires At",
              "type": "DATETIME",
              "key": true
            },
            "createdFor": {
              "title": "Owner",
              "key": true
            },
            "createdBy": {
              "title": "Created By"
            },
            "createdAt": {
              "title": "Created At",
              "type": "DATETIME"
            },
            "userGroup": {
              "title": "User Group",
              "key": true,
              "visible": false
            },
            "profile": {
              "title": "User Profile",
              "key": true,
              "visible": false
            },
            "tokenUserId": {
              "title": "Token User ID",
              "key": true,
              "visible": false
            }
          },
          "custom_columns": [
            {
              "id": "status_display",
              "title": "Access Key Status",
              "expr": "'Expired' if isnull(expiresAt) or max(0,int((float(to_datetime(expiresAt).timestamp())*1000-float(time_now_as_ms()))/1000))<60 else status"
            },
            {
              "id": "valid_for",
              "title": "Valid For",
              "expr": "'' if isnull(expiresAt) else ('Expired' if max(0,int((float(to_datetime(expiresAt).timestamp())*1000-float(time_now_as_ms()))/1000))<60 else ((str(max(0,int((float(to_datetime(expiresAt).timestamp())*1000-float(time_now_as_ms()))/1000))//60)+' minutes') if max(0,int((float(to_datetime(expiresAt).timestamp())*1000-float(time_now_as_ms()))/1000))<3600 else (((str(max(0,int((float(to_datetime(expiresAt).timestamp())*1000-float(time_now_as_ms()))/1000))//3600)+' hours')+((' '+str((max(0,int((float(to_datetime(expiresAt).timestamp())*1000-float(time_now_as_ms()))/1000))%3600)//60)+' minutes') if (max(0,int((float(to_datetime(expiresAt).timestamp())*1000-float(time_now_as_ms()))/1000))%3600)//60>0 else '')) if max(0,int((float(to_datetime(expiresAt).timestamp())*1000-float(time_now_as_ms()))/1000))<86400 else ((str(max(0,int((float(to_datetime(expiresAt).timestamp())*1000-float(time_now_as_ms()))/1000))//86400)+' days')+((' '+str((max(0,int((float(to_datetime(expiresAt).timestamp())*1000-float(time_now_as_ms()))/1000))%86400)//3600)+' hours') if (max(0,int((float(to_datetime(expiresAt).timestamp())*1000-float(time_now_as_ms()))/1000))%86400)//3600>0 else '')))))"
            },
            {
              "id": "is_api_token_user",
              "title": "API Token",
              "expr": "True",
              "key": true,
              "hidden": true
            },
            {
              "id": "emailId",
              "title": "Email ID",
              "expr": "tokenUserId",
              "key": true,
              "hidden": true
            }
          ],
