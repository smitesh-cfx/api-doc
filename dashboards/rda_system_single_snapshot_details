{
  "name": "rda_system_single_snapshot_details",
  "label": "Snapshot Details",
  "description": "Snapshot Details",
  "dashboard_folder": "System",
  "version": "1.0.2",
  "live_edit": true,
  "enabled": false,
  "stream": "rda_system_snapshots_details",
  "dashboard_type": "template",
  "template_variables": {
    "SNAPSHOT_NAME": {
      "contextId": "snapshot_name"
    }
  },
  "dashboard_filters": {
    "time_filter": true,
    "default_time_filter_labels": [
      "All Time"
    ],
    "extra_filter": "snapshot_name is '{{SNAPSHOT_NAME}}'",
    "columns_filter": [
      {
        "id": "artifact_name",
        "label": "Artifact Name",
        "type": "TEXT"
      },
      {
        "id": "artifact_type",
        "label": "Artifact Type",
        "type": "TEXT"
      },
      {
        "id": "artifact_version_visibility",
        "label": "Artifact Checksum In Snapshot Repo",
        "type": "TEXT"
      },
      {
        "id": "checksum",
        "label": "Checksum",
        "type": "TEXT"
      },
      {
        "id": "object_name",
        "label": "Object Name",
        "type": "TEXT"
      },
      {
        "id": "snapshot_name",
        "label": "Snapshot Name",
        "type": "TEXT"
      },
      {
        "id": "snapshot_type",
        "label": "Snapshot Type",
        "type": "TEXT"
      },
      {
        "id": "size",
        "label": "Size",
        "type": "DOUBLE"
      }
    ],
    "group_filters": [
      {
        "stream": "rda_system_snapshots_details",
        "title": "Artifact Type",
        "duration_hours": 87600,
        "limit": 200,
        "extra_filter": "snapshot_name is '{{SNAPSHOT_NAME}}'",
        "group_by": [
          "artifact_type"
        ],
        "ts_column": "timestamp",
        "agg": "sum",
        "column": "count_",
        "type": "int"
      },
      {
        "stream": "rda_system_snapshots_details",
        "title": "Artifact Checksum In Snapshot Repo",
        "duration_hours": 87600,
        "limit": 200,
        "extra_filter": "snapshot_name is '{{SNAPSHOT_NAME}}'",
        "group_by": [
          "artifact_version_visibility"
        ],
        "ts_column": "timestamp",
        "agg": "sum",
        "column": "count_",
        "type": "int"
      }
    ]
  },
  "dashboard_sections": [
    {
      "title": "rda_system_snapshots_details",
      "show_filter": true,
      "widgets": [
        {
          "widget_type": "label",
          "min_width": 3,
          "height": 3,
          "max_width": 6,
          "label": "{% raw %}<div><div style='color: #00aa00; font-size: 20px;'>Changes Since Last Snapshot: {{new_count|int}}</div><div style='color: #888888; font-size: 20px;'>Unchanged: {{unchanged_count|int}}</div></div>{% endraw %}",
          "segments": [
            {
              "stream": "rda_system_snapshots_details",
              "variable": "new_count",
              "ts_column": "timestamp",
              "extra_filter": "artifact_version_visibility == 'new' AND snapshot_name is '{{SNAPSHOT_NAME}}'",
              "agg": "sum",
              "group_by0": "artifact_version_visibility",
              "column": "count_"
            },
            {
              "stream": "rda_system_snapshots_details",
              "variable": "unchanged_count",
              "ts_column": "timestamp",
              "extra_filter": "artifact_version_visibility == 'unchanged' AND snapshot_name is '{{SNAPSHOT_NAME}}'",
              "agg": "sum",
              "group_by0": "artifact_version_visibility",
              "column": "count_"
            }
          ],
          "widget_id": "23af24fa"
        },
        {
