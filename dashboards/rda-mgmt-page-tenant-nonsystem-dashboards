{
  "name": "rda-mgmt-page-tenant-nonsystem-dashboards",
  "label": "Dashboards",
  "description": "User Dashboard Management Page",
  "enabled": false,
  "dashboard_type": "dashboard",
  "dashboard_folder": "System",
  "stream": "rda_dashboards_meta",
  "dashboard_filters": {
    "time_filter": true,
    "extra_filter": "( dashboard_folder not in 'System')",
    "group_filters": [
      {
        "stream": "rda_dashboards_meta",
        "title": "Folder",
        "duration_hours": 87600,
        "limit": 200,
        "extra_filter": null,
        "group_by": [
          "dashboard_folder"
        ],
        "ts_column": "saved_time",
        "agg": "value_count",
        "column": "count_",
        "type": "int"
      },
      {
        "stream": "rda_dashboards_meta",
        "title": "Type",
        "duration_hours": 87600,
        "limit": 200,
        "group_by": [
          "dashboard_type"
        ],
        "ts_column": "saved_time",
        "agg": "value_count",
        "column": "count_",
        "type": "int"
      }
    ],
    "columns_filter": [
      {
        "id": "saved_time",
        "label": "Saved Time",
        "type": "DATETIME"
      },
      {
        "id": "name",
        "label": "Name",
        "type": "TEXT"
      },
      {
        "id": "label",
        "label": "Label",
        "type": "TEXT"
      },
      {
        "id": "dashboard_folder",
        "label": "Folder",
        "type": "TEXT"
      },
      {
        "id": "dashboard_type",
        "label": "Dashboard Type",
        "type": "TEXT"
      },
      {
        "id": "_RDA_Id",
        "label": "_RDA_ID",
        "type": "TEXT"
      },
      {
        "id": "count_",
        "label": "Count_",
        "type": "DOUBLE"
      },
      {
        "id": "description",
        "label": "Description",
        "type": "TEXT"
      },
      {
        "id": "reltime",
        "label": "RelTime",
        "type": "DATETIME"
      },
      {
        "id": "enabled",
        "label": "Enabled",
        "type": "BOOLEAN"
      },
      {
        "id": "timestamp",
        "label": "Timestamp",
        "type": "DATETIME"
      }
    ]
  },
  "dashboard_sections": [
    {
      "title": "Dashboards",
      "show_filter": true,
      "widgets": [
        {
          "widget_type": "pie_chart",
          "title": "Dashboards by Folders",
          "stream": "rda_dashboards_meta",
          "ts_column": "saved_time",
          "duration_hours": 87600,
          "min_width": 6,
          "height": 4,
          "max_width": 6,
          "limit": 25,
          "column": "count_",
          "agg": "value_count",
          "group_by": [
            "dashboard_folder"
          ],
          "type": "int",
          "widget_id": "bf50e7c9"
        },
        {
          "widget_type": "pie_chart",
          "title": "Dashboards by Type",
          "stream": "rda_dashboards_meta",
          "ts_column": "saved_time",
          "duration_hours": 87600,
          "min_width": 6,
          "height": 4,
          "max_width": 6,
          "limit": 25,
          "column": "count_",
          "agg": "value_count",
          "group_by": [
            "dashboard_type"
          ],
          "type": "int",
          "widget_id": "cad3aabd"
        },
        {
          "title": "Dashboards",
          "widget_type": "tabular",
          "stream": "rda_dashboards_meta",
          "duration_hours": 87600,
          "timebased": true,
          "remote_searchable": true,
          "remote_searchable_cols": [
            "name",
            "dashboard_folder",
            "dashboard_type",
            "label",
            "description"
          ],
          "ts_column": "saved_time",
          "paginated": true,
          "height": 10,
          "min_wdith": 12,
          "columns": {
            "name": {
              "title": "Name",
              "key": true,
              "type": "TEXT"
            },
            "dashboard_folder": {
              "title": "Dashboard Folder",
              "type": "TEXT"
            },
            "type": {
              "title": "Type",
              "type": "FIXED_VALUE",
              "value": "Dashboard",
              "visible": false,
              "sortable": false
            },
            "dashboard_type": {
              "title": "Dashboard Type",
              "type": "TEXT"
            },
            "label": {
              "title": "Label",
              "key": true,
              "type": "TEXT"
            },
            "description": {
              "title": "description"
            },
            "saved_time": {
              "title": "Saved Time",
              "type": "DATETIME"
            },
            "tags": {
              "title": "Tags",
              "type": "TEXT"
            },
            "timestamp": {
              "title": "When",
              "type": "HUMANIZE_TIME_DELTA",
              "source-column": "saved_time",
              "sortable": false
            },
            "menu_folder": {
              "title": "Menu Folder",
              "type": "TEXT",
              "hidden": false,
              "key": true
            }
          },
          "custom_columns": [
            {
              "id": "enabled",
              "label": "Enabled",
              "htmlTemplateForRow": "<span class='badge' style='background-color: {{ row.enableColor }}' > {{ row.enabled }} </span>"
            },
            {
              "id": "id",
              "label": "ID",
              "expr": "'user-dashboard-' + name",
              "visible": false,
              "key": true,
              "sortable": false
            },
            {
              "id": "url",
              "label": "URL",
              "expr": "'/workspace/dashboard/user-dashboard-' + name",
              "visible": false,
              "sortable": false
            },
            {
              "id": "enableColor",
              "label": "Enable Color",
              "expr": "['#4CAF50'] if enabled else ['#9E9E9E']",
              "hidden": true,
              "visible": false,
              "sortable": false
            },
            {
              "id": "rowStyleClass",
              "hidden": true,
              "visible": false,
              "expr": "'bg-fading-blue' if time_now_as_ms() - isoformat_to_ms(saved_time) <= 120000 else None",
              "sortable": false
            }
          ],
          "actions": [
            {
              "permission": "rda:user_dashboard:view",
              "appName": "user-dashboard",
              "displayLabelColumnId": "id",
              "drillDownLinkField": "name",
              "identifier": "user.dashboard.view",
              "selectionType": "SINGLE",
              "stateName": "app.featureapp",
              "title": "Dashboard",
              "type": "GO_TO_APP_STATE"
            },
            {
              "permission": "rda:user_dashboard:view",
              "title": "View YAML",
              "type": "POPUP_FORM",
              "selectionType": "SINGLE",
              "identifier": "saas-service-action:userdashboard-view-yaml",
              "api-endpoint": {
                "service-name": "saas-reports",
                "methodName": "getForm",
                "stringified-params": true,
                "parse-output": false,
                "params": [
                  {
                    "formId": "rda.saas.userdashboard.view.yaml"
                  }
                ]
              }
            },
            {
              "permission": "rda:user_dashboard:view",
              "title": "View JSON",
              "type": "POPUP_FORM",
              "selectionType": "SINGLE",
              "identifier": "saas-service-action:userdashboard-view-json",
              "api-endpoint": {
                "service-name": "saas-reports",
                "methodName": "getForm",
                "stringified-params": true,
                "parse-output": false,
                "params": [
                  {
                    "formId": "rda.saas.userdashboard.view.json"
                  }
                ]
              }
            }
          ],
          "widget_id": "c466cddc"
        }
      ]
    }
  ],
