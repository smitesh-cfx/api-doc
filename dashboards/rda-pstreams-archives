          "columns": {
            "stream": {
              "title": "Stream Name",
              "key": true
            },
            "archive_date": {
              "title": "Archive Date",
              "visible": false
            }
          },
          "height": 10,
          "min_wdith": 12,
          "widget_id": "2ea74a7d",
          "pivot": {
            "pivot_type": "advanced",
            "group_by": [
              "stream"
            ],
            "series": [
              {
                "column": "stream",
                "label": "Archives Count",
                "agg": "value_count"
              }
            ]
          },
          "actions": [
            {
              "permission": "rda:pstream:archives",
