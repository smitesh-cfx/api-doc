{
  "name": "rda-pstreams-archives",
  "label": "Archives",
  "description": "Pstream Archives Page",
  "enabled": true,
  "dashboard_type": "dashboard",
  "dashboard_folder": "System",
  "dashboard_style": "auto",
  "dashboard_filters": {
    "time_filter": true,
    "default_time_filter_labels": [
      "Last 12 months"
