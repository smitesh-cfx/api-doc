          "extra_filter": "name is '{{PACK_NAME}}' and ( (deploy_type is 'common' and customer is empty) or (deploy_type is 'customer' and customer is '{{CUST_TAG}}') or (deploy_type is empty and customer is '{{CUST_TAG}}')) and  status in ['success','created','updated', 'skipped','error']",
          "refreshOptions": {
            "refreshType": "Periodic",
            "refreshInterval": 30000
          },
          "columns": {
            "activation_id": {
              "title": "Activation Id",
              "type": "TEXT",
              "hidden": true
            },
            "name": {
              "title": "Pack Name",
              "type": "TEXT",
              "hidden": false
            },
            "version": {
              "title": "Pack Version",
              "type": "TEXT",
              "hidden": false
            },
            "deploy_type": {
              "title": "Deployment Type",
              "type": "TEXT",
              "hidden": false
            },
            "customer": {
              "title": "Customer",
              "type": "TEXT",
              "hidden": false
            },
            "art_name": {
              "title": "Artifact Name",
              "type": "TEXT",
              "hidden": false
            },
            "art_type": {
              "title": "Artifact Type",
              "type": "TEXT",
              "hidden": false
            },
            "art_version": {
              "title": "Artifact Version",
              "type": "TEXT",
              "hidden": false
            },
            "state_color": {
              "type": "COLOR-MAP",
              "source-column": "status",
              "color-map": {
                "success": "#4CAF50",
                "created": "#4CAF50",
                "updated": "#4CAF50",
                "skipped": "#4CAF50",
                "error": "#FF0000"
              }
            },
            "status": {
              "title": "Status",
              "htmlTemplateForRow": "{% raw %}<span class='badge' style='background-color: {{ row.state_color }}' > {{ row.status }} </span>{% endraw %}"
            },
            "message": {
              "title": "Message",
              "type": "TEXT",
              "hidden": false
            },
            "timestamp": {
              "title": "Timestamp",
              "type": "DATETIME",
              "hidden": false
            }
          },
          "widget_id": "4a15dd4f"
        }
      ]
    }
