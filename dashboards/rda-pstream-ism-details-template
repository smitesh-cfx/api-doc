{
  "name": "rda-pstream-ism-details-template",
  "label": "Persistent Stream ISM Details",
  "description": "Persistent Stream ISM Details",
  "enabled": true,
  "dashboard_type": "template",
  "dashboard_folder": "System",
  "dashboard_style": "auto",
  "template_variables": {
    "PSTREAM_NAME": {
      "contextId": "pstream_name"
    },
    "TS_COLUMN": {
      "contextId": "ts_column"
    }
  },
  "dashboard_filters": {
    "time_filter": false
  },
  "dashboard_sections": [
    {
      "title": "ISM Details",
      "show_filter": false,
      "widgets": [
        {
          "title": "Details",
          "height": 5,
          "widget_type": "pstream_ism_details",
          "stream": "{{PSTREAM_NAME}}",
          "ts_column": "{{TS_COLUMN}}",
          "widget_id": "2da925b3"
        },
        {
          "title": "Snapshots",
          "height": 5,
          "widget_type": "pstream_ism_details",
          "stream": "{{PSTREAM_NAME}}",
          "ts_column": "{{TS_COLUMN}}",
          "purpose": "snapshot",
          "context_filter": "ism_policy_template contains 'snapshot'",
          "widget_id": "b56f3ac1"
        },
        {
          "title": "Closed Indices",
          "height": 5,
          "widget_type": "pstream_ism_details",
          "stream": "{{PSTREAM_NAME}}",
          "ts_column": "{{TS_COLUMN}}",
          "purpose": "closed",
          "widget_id": "b56f3ac2"
        }
      ]
    }
  ],
  "pstream_dashboards": [
    {
      "title": "ISM Details",
      "show_filter": false,
      "widgets": [
        {
          "title": "Details",
          "height": 5,
          "widget_type": "pstream_ism_details",
          "stream": "{{PSTREAM_NAME}}",
          "ts_column": "{{TS_COLUMN}}",
          "widget_id": "2da925b3"
        },
        {
          "title": "Snapshots",
          "height": 5,
          "widget_type": "pstream_ism_details",
          "stream": "{{PSTREAM_NAME}}",
          "ts_column": "{{TS_COLUMN}}",
          "purpose": "snapshot",
          "context_filter": "ism_policy_template contains 'snapshot'",
          "widget_id": "b56f3ac1"
        },
        {
          "title": "Closed Indices",
          "height": 5,
          "widget_type": "pstream_ism_details",
          "stream": "{{PSTREAM_NAME}}",
          "ts_column": "{{TS_COLUMN}}",
          "purpose": "closed",
          "widget_id": "b56f3ac2"
        }
      ]
    }
  ]
}