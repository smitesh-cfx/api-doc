 ## .

 ## Main Driver is IRM's oia-incidents-stream.

 ## As one time activity, We pull all incidents from oia-incidents-stream and use them to migrate corresponding collab messages, and team incidents. we may have duplicates from last 90 days.

 ## .

 --> @c:new-block
 --> @dm:empty
 --> @dm:save name="temp-irm-incident-ids-concat"
 ## We can do read all in one go and split them up by 999 and use sql-in clause.

 ## or

 ## Read in batches using bookmark and process them in batches

 ## SQL IN clause might have limitation of max 999 IDs

 --> @c:bookmark-loop bookmark="irm_incident_bkmrk" & initial_value ="2023-08-01 00:00:00" & max_iterations=1
 --> @dm:empty
 --> @dm:addrow name="oia-incidents-stream" & limit=999 & sort_by_col="i_created_ts" & sort_type="asc"
 --> #dm:query-persistent-stream i_created_ts is after '${bookmark}'
 --> @dm:skip-block-if-shape row_count=0
 --> @dm:check-columns must_contain="incident_id" & action="skip-block"
 ## .

 --> @dm:selectcolumns include="project_id|customer_id|incident_id|i_state|i_created_ts|i_updated_ts|timestamp"
 --> @dm:save name="temp-irm-incidents"
 ## .

 --> @dm:selectcolumns include="incident_id|project_id"
 --> @dm:map to="name" & func="fixed" & value="incident"
 --> @dm:save name="temp-irm-incident-ids"
 ## .

 ## --> @exec:for-loop num_rows = 999

 --> @dm:eval incident_id="incident_id + '\',\''"
 --> @dm:eval project_id="project_id + '\',\''"
 --> @dm:groupby columns="name" & agg="sum"
 ## .

 --> @dm:eval incident_id="incident_id.replace('CFX', '\'CFX', 1)"
 --> @dm:eval incident_id="incident_id[:-2] if (incident_id.endswith(',\'')) else incident_id"
 ## .

 --> @dm:eval project_id="project_id.replace('', '\'', 1)"
 --> @dm:eval project_id="project_id[:-2] if (project_id.endswith(',\'')) else project_id"
 ## .

 --> @dm:save name="temp-irm-incident-ids-concat"
 ## --> @exec:end-loop & append="yes"

